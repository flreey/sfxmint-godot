static func text(id: String) -> String:
	return COPY.get(id, id)
static func error(result: Dictionary) -> String:
	var code := str(result.get("error", "request_failed"))
	if int(result.get("status", 0)) == 404:
		return "This API endpoint is not available on the server yet. Update the server or try again later."
	return ERRORS.get(code, "Request failed (%s). Keep your description and try again." % code)
